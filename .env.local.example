# Gemini API Key
GEMINI_API_KEY=your_api_key_here

# Set to 'true' to use mock API responses in development
MOCK_API=true

# Enable debug logging
DEBUG=false

# Maximum image size for processing (in pixels)
MAX_IMAGE_DIMENSION=1200

# Note: As of July 2024, this app uses gemini-2.0-flash-exp-image-generation model
# for image generation capabilities. Ensure your API key has access to this model.
